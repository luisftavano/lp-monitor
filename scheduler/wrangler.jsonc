{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lp-monitor-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Sem endpoint HTTP público: o Worker só roda pelo cron.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "GITHUB_REPO": "luisftavano/lp-monitor",
    "WORKFLOW_FILE": "monitor.yml"
  },
  // GITHUB_TOKEN é secret: npx wrangler secret put GITHUB_TOKEN
  "observability": {
    "enabled": true
  }
}
